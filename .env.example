# Server-only. Copy to .env.local. Values from `npx supabase status` (local) or the Supabase dashboard (prod).
SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key. It can only call the read RPCs. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_RPC_KEY=
# Never put the service-role key in this app or in Vercel. It lives only in GitHub Actions secrets (Plan 2).
